{
  "variables": [
    {
      "name": "ratification_stance",
      "domain": [
        "favor_ratification",
        "oppose_ratification",
        "favor_with_amendments"
      ],
      "description": "The document's overall position on whether the proposed Constitution should be ratified as submitted."
    },
    {
      "name": "governance_structure",
      "domain": [
        "national_consolidated",
        "federal_confederation",
        "compound_federal_national"
      ],
      "description": "Whether the plan is characterized as a consolidated national government, a federal league of sovereign states, or a mixed/compound of both (Madison's 'partly federal, partly national')."
    },
    {
      "name": "standing_army_peacetime",
      "domain": [
        "necessary_and_safe",
        "dangerous_to_liberty"
      ],
      "description": "Whether a peacetime standing army under the new Constitution is viewed as a necessary, safely-checked provision or as a serious threat to liberty."
    },
    {
      "name": "bill_of_rights_necessity",
      "domain": [
        "necessary",
        "unnecessary_or_dangerous"
      ],
      "description": "Whether an explicit bill of rights is needed to protect the people, or is unnecessary/potentially dangerous given the Constitution's structure."
    },
    {
      "name": "federal_taxation_scope",
      "domain": [
        "unlimited_taxation_power",
        "limited_to_external_imposts"
      ],
      "description": "Whether the federal government's taxing power should be unlimited (reaching internal/direct taxes) or restricted mainly to external duties/imposts, leaving internal taxation to the states."
    },
    {
      "name": "executive_power_character",
      "domain": [
        "safely_limited_republican",
        "dangerously_monarchical"
      ],
      "description": "Whether the presidency as designed is an appropriately energetic but checked republican office, or an excessively powerful, king-like executive."
    },
    {
      "name": "judiciary_power_scope",
      "domain": [
        "properly_limited",
        "dangerously_expansive"
      ],
      "description": "Whether the federal judiciary's jurisdiction, tenure, and appellate powers are properly bounded, or likely to expand and swallow state authority."
    },
    {
      "name": "house_representation_adequacy",
      "domain": [
        "adequate",
        "insufficient"
      ],
      "description": "Whether the number of representatives in the House of Representatives is adequate to genuinely represent the people, or dangerously/insufficiently small."
    },
    {
      "name": "confederation_adequacy",
      "domain": [
        "inadequate_requires_new_government",
        "adequate_needs_only_amendment"
      ],
      "description": "Whether the existing Articles of Confederation are fundamentally inadequate and require wholesale replacement, or are basically workable and need only targeted amendment."
    },
    {
      "name": "senate_character",
      "domain": [
        "appropriate_check",
        "dangerous_aristocracy"
      ],
      "description": "Whether the Senate as structured (indirect election, six-year terms, blended powers) is a valuable balancing check on government, or a body tending toward permanent aristocracy."
    }
  ],
